# Slack notifications
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#claudia
# Slack channel ID for review-request notifications (per-PR + daily digest).
# Defaults to #artemistest if unset.
SLACK_REVIEW_CHANNEL=C012NFRM76F

# GitHub webhook secret (HMAC-SHA256 validation)
WEBHOOK_SECRET=your-webhook-secret-here

# Optional overrides
# MEMORIES_DIR=~/memories
# GITHUB_USER=claudia-bot

# Backend selection (codex|claude). Default: codex.
CLAUDIA_BACKEND=codex
# Optional codex binary path (unset or empty = use `codex` from PATH).
CODEX_BIN=
# Optional override for codex price table (default: backends/codex_prices.json).
CLAUDIA_CODEX_PRICES=
